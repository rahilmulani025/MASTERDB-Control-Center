# MASTERDB Control Center — Environment Configuration
#
# Copy this file to .env and fill in the value for your environment.
# NEVER commit .env to version control — it is listed in .gitignore.
#
# ─── MASTERDB Backend URL ─────────────────────────────────────────────────────
#
# Local development (Vite dev server with proxy):
#   Leave BLANK — the Vite proxy in vite.config.ts routes API calls automatically.
#   VITE_MASTERDB_API_URL=
#
# OR set an explicit absolute URL for your running backend:
#   VITE_MASTERDB_API_URL=http://127.0.0.1:8000
#
# Production (reverse proxy deployment):
#   Leave BLANK — API requests become relative paths served by your web server.
#   VITE_MASTERDB_API_URL=
#
# IMPORTANT:
#   All VITE_ variables are compiled into the browser bundle and are PUBLIC.
#   Do NOT put secrets, tokens, private keys, or database credentials here.

VITE_MASTERDB_API_URL=
