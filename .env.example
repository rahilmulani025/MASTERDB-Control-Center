# MASTERDB Control Center — Environment Configuration
#
# ─── MASTERDB Backend Proxy Target (Vite Dev Server) ──────────────────────────
# The backend URL to which the local Vite dev server forwards API requests.
# Default: https://bhiv-masterdb-ingestion-certification.onrender.com
# For a local Python backend: http://127.0.0.1:8000
VITE_MASTERDB_BACKEND_TARGET=https://bhiv-masterdb-ingestion-certification.onrender.com

# ─── MASTERDB Browser API Base URL ───────────────────────────────────────────
# Local development (Vite dev server with proxy):
#   Leave BLANK — requests use relative paths and go through Vite proxy (no CORS issues).
#   VITE_MASTERDB_API_URL=
#
# Production (direct absolute URL when CORS headers are present):
#   VITE_MASTERDB_API_URL=https://bhiv-masterdb-ingestion-certification.onrender.com
VITE_MASTERDB_API_URL=

